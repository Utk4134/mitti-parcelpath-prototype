{
  "name": "mitti-parcelpath-prototype",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "data": "tsx scripts/generate-data.ts && tsx scripts/save-answers.ts",
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "dev:api": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "check:key": "tsx scripts/check-key-safety.ts",
    "build:api": "npx esbuild server/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=api/index.js --banner:js=\"import { createRequire as __cr } from 'module'; const require = __cr(import.meta.url);\""
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "cross-env": "7.0.3",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.13.3",
    "tsx": "4.19.2",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.21",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
