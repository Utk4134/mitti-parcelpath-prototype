# Gemini (required)
GEMINI_API_KEY=
# Spec models are gemini-2.5-flash / gemini-2.5-pro; Google now returns 404 for them on new keys,
# so the server defaults to the models below. A comma list is tried in order when a model is busy (503/429/timeout).
GEMINI_MODEL_DEFAULT=gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_MODEL_HEAVY=gemini-3.1-pro-preview
PRO_FOR_CAPACITY=false

# Safeguards
AI_RATE_LIMIT_PER_HOUR=15
AI_DAILY_CAP=500
ACCESS_CODE=

# Server
PORT=8787
# Test flag: force a simulated Pro 429 to check the Pro -> Flash fallback
FORCE_PRO_429=false

# Vercel only (optional, for shared rate-limit counts)
KV_REST_API_URL=
KV_REST_API_TOKEN=
